  {
   "id": 0,
   "zh": "已经累了吗？要终止捕捉秀吗？",
   "en": "Tired already? Would you like to end{NEWLINE}your Catching Show?",
   "status": "draft",
   "origin": "agent",
   "notes": ""
  },
  {
   "id": 1,
   "zh": "期待与你再次见面！{SCROLL}",
   "en": "We look forward to seeing you again!{SCROLL}",
   "status": "draft",
   "origin": "agent",
   "notes": ""
  },
  {
   "id": 2,
   "zh": "不愧是{VAR:0103:0}君！{NEWLINE}别放弃,继续努力！",
   "en": "That’s the spirit, {VAR:0103:0}! Don’t give{NEWLINE}up. Keep at it!",
   "status": "draft",
   "origin": "agent",
   "notes": ""
  },
