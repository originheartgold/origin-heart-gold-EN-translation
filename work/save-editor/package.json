{
  "name": "origin-save-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs ../save-core/tests/*.test.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "typecheck": "node scripts/build.mjs --check",
    "lint": "node node_modules/eslint/bin/eslint.js src --max-warnings 0 && npm --prefix ../save-core run lint",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:mutations",
    "test:mutations": "npm --prefix ../save-core run test:mutations"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "eslint": "9.28.0",
    "@typescript-eslint/parser": "8.34.0",
    "@typescript-eslint/eslint-plugin": "8.34.0"
  },
  "engines": {
    "node": ">=22"
  }
}
