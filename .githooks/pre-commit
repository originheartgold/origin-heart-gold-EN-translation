#!/bin/sh
# The repo's pre-commit check: python3 work/tools/check.py --staged (the fast check on what is being committed).
# Not active by itself. It is run by the clone's shared hook .git/hooks/pre-commit, which stays the entry point
# (it also runs the author identity guard); see CONTRIBUTING.md -> Checks for the dispatcher to put there.
# Skip it for one commit with `git commit --no-verify`.
#
# What runs, by the staged paths:
#   Python, work/patches/, ruff.toml, work/tools/requirements*, .githooks/  the whole fast check (about 6 s)
#   only the decision register (work/translate/decisions/decisions.jsonl)    the fix registry only (< 1 s)
#   anything else (translation banks, guide, site)                           nothing
# Python: $POKE_PYTHON, else the shared clone's .venv/bin/python when there is one, else python3 (3.11 or
# newer, with the packages of work/tools/requirements-runtime.txt and ruff from requirements-dev.txt).
set -e
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
if printf '%s\n' "$staged" | grep -Eq \
    '(\.py$|^work/patches/|^ruff\.toml$|^work/tools/requirements|^\.githooks/)'; then
    scope=""
elif printf '%s\n' "$staged" | grep -Eq '^work/translate/decisions/decisions\.jsonl$'; then
    scope="--registry-only"
else
    exit 0
fi
if ! git cat-file -e :work/tools/check.py 2>/dev/null; then
    echo "pre-commit: work/tools/check.py is not in the commit (deleted or moved); check skipped" >&2
    exit 0
fi
py=${POKE_PYTHON:-}
if [ -z "$py" ]; then
    venv="$(git rev-parse --git-common-dir)/../.venv/bin/python"
    if [ -x "$venv" ]; then py=$venv; else py=python3; fi
fi
if ! "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    echo "pre-commit: $py is missing or older than Python 3.11 (tomllib); set POKE_PYTHON to a newer one" >&2
    exit 1
fi
exec "$py" "$(git rev-parse --show-toplevel)/work/tools/check.py" --staged $scope
