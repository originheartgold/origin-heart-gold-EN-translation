---
import { playerNote } from '../lib/reference-format.mjs';
// Keep each evolution and its conditions together in one sentence.
import Mon from './Mon.astro';
import { speciesById, itemById, itemUrl, moveById, moveUrl, type EvoLink, type EvoCond } from '../lib/data';
const { label, entries } = Astro.props as { label: string; entries: EvoLink[] };
const name = (id: number, fallback?: string) => speciesById.get(id)?.name ?? fallback ?? '?';
// These conditions are checked on level-up; holding an item or learning a move alone does not trigger them.
const trigger = (entry: EvoLink) => /^(level up\b|high friendship\b|Beauty\b)/.test(entry.how) ? ' when leveled up' : '';
/** A condition split around its link: [text before, link, text after]. */
function parts(c: EvoCond) {
	const text = c.text.startsWith('holding ') ? `while ${c.text}` : c.text;
	const [pre, post = ''] = text.split('{}');
	if (!c.text.includes('{}')) return { pre, post: '' };
	if (c.species !== undefined) return { pre, post, mon: c.species };
	const it = c.item !== undefined ? itemById.get(c.item) : undefined;
	const mv = c.move !== undefined ? moveById.get(c.move) : undefined;
	return { pre, post, href: it ? itemUrl(it) : moveUrl(mv), text: it?.name ?? mv?.name ?? '?' };
}
const single = entries.length === 1;
---
{single ? (
	<p>{label} <Mon id={entries[0].id} name={name(entries[0].id, entries[0].name)} />
		{entries[0].never ? (
			entries[0].blocked
				? <>: <strong>not available through normal play</strong>: {playerNote(entries[0].blocked)}.</>
				: <>: <strong>not possible in this game</strong>. This method does not work (in the official games: {entries[0].official}).</>
		) : (
			<>{trigger(entries[0])}{entries[0].conds.map((c) => { const p = parts(c); return <> {p.pre}{p.mon !== undefined ? <Mon id={p.mon} name={name(p.mon)} /> : p.href ? <a href={p.href}>{p.text}</a> : p.text}{p.post}</>; })}.</>
		)}
	</p>
) : (
	<p>{label}:</p>
)}
{!single && (
	<ul>
		{entries.map((e) => (
			<li>
				<Mon id={e.id} name={name(e.id, e.name)} />
				{e.never ? (
					e.blocked
						? <>: <strong>not available through normal play</strong> ({playerNote(e.blocked)})</>
						: <>: <strong>not possible in this game</strong> (in the official games: {e.official})</>
				) : (
					<>{trigger(e)}{e.conds.map((c) => { const p = parts(c); return <> {p.pre}{p.mon !== undefined ? <Mon id={p.mon} name={name(p.mon)} /> : p.href ? <a href={p.href}>{p.text}</a> : p.text}{p.post}</>; })}.</>
				)}
			</li>
		))}
	</ul>
)}
