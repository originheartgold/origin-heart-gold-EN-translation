---
import type { Trainer } from '../lib/data';
import { speciesById } from '../lib/data';
import PokemonImage from './PokemonImage.astro';
const { team, compact = false } = Astro.props as { team: Trainer['team']; compact?: boolean };
const List = compact ? 'span' : 'ul';
const Entry = compact ? 'span' : 'li';
---
<List class:list={['team-preview', { 'team-preview-compact': compact }]} aria-label={compact ? undefined : 'Team Pokémon'} aria-hidden={compact ? 'true' : undefined}>
  {team.map(mon => <Entry class="preview-mon" title={`${mon.name} · Lv. ${mon.level}`}>
    {speciesById.has(mon.id!) ? <PokemonImage s={speciesById.get(mon.id!)!} inline={compact} /> : <span class="unknown-mon" aria-hidden="true">?</span>}
    <span class="preview-name">{mon.name}</span>
    <span class="preview-level">Lv. {mon.level}</span>
  </Entry>)}
</List>
<style>
  .team-preview { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .3rem; list-style: none; padding: 0; margin: 0; }
  .team-preview .preview-mon { min-width: 0; margin: 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .team-preview :global(.pokemon-image-small) { width: 100%; height: auto; flex: none; max-width: 64px; }
  .team-preview :global(img) { width: 100%; height: auto; aspect-ratio: 1; }
  .preview-name { font-size: .65rem; line-height: 1.3; overflow-wrap: anywhere; margin: .25rem 0 0; }
  .preview-level { font-size: .65rem; color: var(--sl-color-gray-3); margin: .1rem 0 0; }
  .unknown-mon { display: grid; place-items: center; width: 100%; aspect-ratio: 1; font-size: 1.5rem; color: var(--sl-color-gray-3); }
  .team-preview-compact { display: flex; flex-wrap: wrap; gap: .3rem; }
  .team-preview-compact .preview-mon { width: 40px; }
  .team-preview-compact .preview-name, .team-preview-compact .preview-level { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
