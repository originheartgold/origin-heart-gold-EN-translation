---
// Screenshot grid of the 17 camera presets (page: camera-codes.mdx). Screenshots: English rc5 in DeSmuME,
// Route 1 and a Poké Mart, clock pinned to noon; each shot taken with the force-preset code on.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PRESET_NAMES } from '../lib/camera-codes.mjs';

interface Props { kind: 'outdoor' | 'indoor' }
const { kind } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/camera/presets/*.png', { eager: true });
const place = kind === 'outdoor' ? 'Route 1' : 'a Poké Mart';
const hex2 = (i: number) => i.toString(16).toUpperCase().padStart(2, '0');
const shots = PRESET_NAMES.map((name: string, i: number) => ({
	id: hex2(i), name, src: files[`../assets/camera/presets/${kind}-${i.toString(16).padStart(2, '0')}.png`].default,
}));
---
<ul class="campre not-content">
	{shots.map((s) => (
		<li>
			<figure>
				<Image src={s.src} alt={`${place} with camera preset ${s.id}`} width={256} widths={[256, 512]} sizes="(max-width: 40rem) 45vw, 11rem" />
				<figcaption><code>{s.id}</code> {s.name}</figcaption>
			</figure>
		</li>
	))}
</ul>

<style>
	.campre {
		list-style: none; padding: 0 !important; margin: 1rem 0 1.5rem !important;
		display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 0.75rem;
	}
	.campre li { margin: 0 !important; }
	.campre figure { margin: 0; }
	.campre img { width: 100%; height: auto; display: block; border-radius: 0.3rem; image-rendering: pixelated; }
	.campre figcaption { font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); margin-top: 0.25rem; line-height: 1.3; }
	.campre code { font-weight: 700; color: var(--sl-color-white); }
</style>
