---
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a class="site-title" href={siteTitleHref} aria-label="Origin HeartGold Guide home"><span>ORIGIN <strong>HEARTGOLD</strong></span><small>THE ENGLISH PLAYER’S GUIDE</small></a>
<style>
  .site-title { display: flex; flex-direction: column; gap: .15rem; color: var(--sl-color-white); text-decoration: none; white-space: nowrap; line-height: 1.2; }
  .site-title > span { font-size: 1.02rem; letter-spacing: -.025em; font-weight: 750; }
  .site-title strong { color: var(--sl-color-text-accent); }
  .site-title small { font-size: .54rem; letter-spacing: .16em; color: var(--sl-color-gray-3); }
  @media (max-width: 24rem) { .site-title > span { font-size: .86rem; } .site-title small { font-size: .46rem; } }
</style>
