---
import Mon from './Mon.astro';
import { itemById, itemUrl } from '../lib/data';
import type { FormChange } from '../lib/verified-mechanics';
const { entries } = Astro.props as { entries: FormChange[] };
import { speciesById } from '../lib/data';
---
<ul>{entries.map((f) => <li>
	<Mon id={f.base} name={speciesById.get(f.base)?.name ?? 'Pokémon'} /> holding <a href={itemUrl(itemById.get(f.item))}>{itemById.get(f.item)?.name}</a> becomes <Mon id={f.result} name={speciesById.get(f.result)?.name ?? 'another form'} />. {f.condition.replace(' Tested in an emulator.', '')}
</li>)}</ul>
<p>These are held-item transformations, not permanent evolutions. Removing the required item returns the Pokémon to its base form.</p>
