---
import type { Trainer } from '../lib/data';
import { areaUrl, itemById, itemUrl, moveById, moveUrl, speciesById, url } from '../lib/data';

import Mon from './Mon.astro';
import AbilityLink from './AbilityLink.astro';
import TrainerTeamPreview from './TrainerTeamPreview.astro';
import PokemonImage from './PokemonImage.astro';
// `area`: on a location page, list only the battles in that area (all of them if none match).
const { t, showPlaces = false, area, note, expanded = false, showProfileLink = true, illustrated = false } = Astro.props as { t: Trainer; showPlaces?: boolean; area?: string; note?: string; expanded?: boolean; showProfileLink?: boolean; illustrated?: boolean };
// One line per distinct battle: place, format and (when a scene picks between teams) the condition in words.
const here = area ? t.places.filter((p) => p.area === area) : [];
const battles = [...new Map((here.length ? here : t.places).map((p) => [`${p.map}|${p.how}|${p.conds.join('|')}`, p])).values()];
const ivText = (m: Trainer['team'][number]) => m.hpIvs === m.ivs ? `${m.ivs}` : `${m.hpIvs} HP / ${m.ivs} others`;
const showEvs = t.team.some((m) => m.evs);
const EV_STATS = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
const evText = (evs: number[] | null) =>
	evs ? evs.map((v, i) => (v ? `${v} ${EV_STATS[i]}` : '')).filter(Boolean).join(', ') : '0';
const label = `${t.cls} ${t.name}`.trim() || 'Unnamed trainer';
const partnerOnly = battles.length > 0 && battles.every((p) => p.how.startsWith('your partner'));
const inactive = battles.length > 0 && battles.every((p) => p.conds.length > 0 && p.conds.every((c) => c.startsWith('never ')));
---
<details class="trainer" open={expanded} id={`trainer-${t.id}`}>
	<summary>
		<span class="trainer-name">{label}</span>
		{illustrated && <TrainerTeamPreview team={t.team} compact />}
		<span class="trainer-team">{t.team.map((m) => `${m.name} ${m.level}`).join(' · ')}</span>
		{partnerOnly && <span class="tag">Partner</span>}
		{inactive && <span class="tag">Inactive scene</span>}
		{!battles.length && <span class="tag">Encounter unconfirmed</span>}
	</summary>
	{(note || t.note) && <p class="small">{note || t.note}</p>}
	{!battles.length && <p class="small">No battle location is known for this team. Facility battles may use a different team.</p>}
	{battles.length > 0 && (
		<ul class="small trainer-battles">
			{battles.map((p) => (
				<li>
					{p.map && (showPlaces && p.area ? <a href={areaUrl(p.area)}>{p.map}</a> : p.map)}{p.map && ': '}
					{p.how}{p.conds.length > 0 && `, ${p.conds.join(' or ')}`}
				</li>
			))}
		</ul>
	)}
	{t.items.length > 0 && <p class="small">Uses items: {t.items.join(', ')}</p>}
	<table class="compact">
		<thead><tr><th>Pokémon</th><th>Lv</th><th>Ability</th><th>Item</th><th>Nature</th><th>IVs</th>{showEvs && <th>EVs</th>}<th>Moves</th></tr></thead>
		<tbody>
			{t.team.map((m) => (
				<tr>
					<td><div class="pokemon-cell">{speciesById.has(m.id!) && <PokemonImage s={speciesById.get(m.id!)!} />}<Mon id={m.id} name={m.name} /></div></td>
					<td>{m.level}</td>
					<td>{m.abilityId ? <AbilityLink id={m.abilityId} /> : (m.ability ?? (m.id ? 'Species default' : '—'))}</td>
					<td>{m.itemId && itemById.has(m.itemId) ? <a href={itemUrl(itemById.get(m.itemId))}>{m.item}</a> : (m.item ?? '—')}</td>
					<td>{m.nature ?? (m.id ? 'Generated' : '—')}</td>
					<td>{ivText(m)}</td>
					{showEvs && <td>{evText(m.evs)}</td>}
					<td>{m.moves.length ? m.moves.map((mv, i) => {
						const mm = moveById.get(m.moveIds[i]);
						return <>{i > 0 && ', '}{mm ? <a href={moveUrl(mm)}>{mv}</a> : mv}</>;
						}) : <em>{m.id ? 'level-up moves' : '—'}</em>}</td>
				</tr>
			))}
		</tbody>
	</table>
	<p class="small muted">IVs show HP separately when it differs; “others” means each of the other five stats.
		{!showEvs && ' No EV investment.'} “Generated” means the nature can vary.</p>

	{showProfileLink && <p class="small"><a href={url(`/trainers/records/${t.id}/#trainer-${t.id}`)}>View all encounters and teams</a></p>}
</details>
