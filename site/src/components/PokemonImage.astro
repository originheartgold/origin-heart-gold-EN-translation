---
import { referenceArtwork } from '../../../work/save-editor/src/ui/artwork';
import { speciesById, type Species } from '../lib/data';
const { s, size = 'small', loading = 'lazy', inline = false } = Astro.props as { s: Species; size?: 'small' | 'large'; loading?: 'lazy' | 'eager'; inline?: boolean };
const Frame = inline ? 'span' : 'figure';
const Caption = inline ? 'span' : 'figcaption';
const art = referenceArtwork(s.baseSpeciesId, s.formId);
const large = size === 'large';
const baseName = speciesById.get(s.baseSpeciesId)?.name ?? `species #${s.baseSpeciesId}`;
const label = art?.baseFallback ? `${baseName} standard-form artwork` : `${s.name} artwork`;
---
<Frame class={`pokemon-image pokemon-image-${size}`}>
  {art ? <img src={art.src} data-artwork-fallback={art.fallback} alt={large ? label : ''} aria-hidden={large ? undefined : 'true'} width={large ? 256 : 48} height={large ? 256 : 48} loading={loading} decoding="async" /> : <span class="art-placeholder" aria-label={large ? 'Artwork unavailable' : undefined} aria-hidden={large ? undefined : 'true'}>—</span>}
  {art?.baseFallback && <Caption class={large ? 'small muted' : 'sr-only'}>Artwork shows {baseName}’s standard form.</Caption>}
  {large && <Caption class="small muted">Artwork: <a href="https://github.com/PokeAPI/sprites">PokéAPI</a>.</Caption>}
</Frame>
<script>
function setupArtwork() {
  document.querySelectorAll<HTMLImageElement>('img[data-artwork-fallback]').forEach(img => {
    if (img.dataset.artworkReady) return;
    img.dataset.artworkReady = '1';
    const failed = () => {
      const fallback = img.dataset.artworkFallback;
      if (fallback) { delete img.dataset.artworkFallback; img.src = fallback; }
      else { const span = document.createElement('span'); span.className = 'art-placeholder'; span.textContent = '—'; if (img.alt) { span.setAttribute('role', 'img'); span.setAttribute('aria-label', `${img.alt}: image unavailable`); } else span.setAttribute('aria-hidden', 'true'); img.replaceWith(span); }
    };
    img.addEventListener('error', failed);
    if (img.complete && img.naturalWidth === 0) failed();
  });
}
setupArtwork();
document.addEventListener('astro:page-load', setupArtwork);
</script>
