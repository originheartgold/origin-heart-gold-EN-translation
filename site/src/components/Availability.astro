---
import { playerNote } from '../lib/reference-format.mjs';
import { url } from '../lib/data';
const { reason, detail = false } = Astro.props as { reason?: string | null; detail?: boolean };
---
{reason && (detail ? <aside class="availability-note">
  <strong>NOT AVAILABLE IN GAME</strong>
  <p>Not available through normal play. {playerNote(reason)}</p>

</aside> : <span class="availability-badge">NOT AVAILABLE IN GAME</span>)}
<style>
.availability-badge { display: inline-block; font-size: .7rem; font-weight: 700; border: 1px solid var(--sl-color-gray-3); border-radius: .25rem; padding: .1rem .35rem; color: var(--sl-color-text); }
.availability-note { border-inline-start: .25rem solid var(--sl-color-orange); background: var(--sl-color-gray-6); padding: 1rem; margin-block: 1rem; }
.availability-note p { margin-block: .5rem 0; }
</style>
