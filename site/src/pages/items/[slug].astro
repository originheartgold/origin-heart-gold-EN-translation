---
import Availability from '../../components/Availability.astro';
import FormChanges from '../../components/FormChanges.astro';
import { formChanges } from '../../lib/verified-mechanics';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { items, areaUrl, areaBySlug, speciesById, pokemonUrl, url, type Item } from '../../lib/data';

export function getStaticPaths() {
	return items.map((i) => ({ params: { slug: i.slug }, props: { i } }));
}
const { i } = Astro.props as { i: Item };
const forms = formChanges.filter((f) => f.item === i.id);
const wildHeld = i.wildHeld ?? [];
const groups = new Map<string, Item['sources']>();
for (const s of i.sources) {
	if (!groups.has(s.kind)) groups.set(s.kind, []);
	groups.get(s.kind)!.push(s);
}
const label: Record<string, string> = {
	'item ball': 'Item balls on the ground', hidden: 'Hidden items', gift: 'Gifts from people',
	prize: 'Prizes and menu choices (you get one of several)', 'bought/exchanged': 'Bought or exchanged', shop: 'Shops', automatic: 'Automatic equipment', 'savings reward': 'Savings purchases',
	'minigame prize': 'Minigame prizes', 'held by wild Pokémon': 'Held by wild Pokémon', Pickup: 'Found with Pickup', tree: 'Trees', stolen: 'Stolen in battle',
};
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
// The item's price only means something to players as a buy price when a shop sells it; it always sells for half.
const sold = i.sources.some((s) => s.kind === 'shop');
const priceLine = i.price ? (sold ? ` · buy for ${money(i.price)}, sells for ${money(Math.floor(i.price / 2))}` : ` · sells for ${money(Math.floor(i.price / 2))}`) : '';
---
<StarlightPage frontmatter={{ title: i.name, description: `Where to get ${i.name} in Origin HeartGold.` }}>
	<p class="small muted">{i.pocket} pocket{priceLine}{i.game ? ` · in-game spelling: ${i.game}` : ''}</p>
	<Availability reason={i.unavailableReason} detail />
	{!i.unavailableReason && i.sources.length === 0 && wildHeld.length === 0 && <p><strong>No confirmed way to get it.</strong> {i.note ?? 'No source was found in the game data.'}</p>}
	{[...groups].map(([kind, list]) => <>
		<h2>{label[kind] ?? kind}</h2>
		<ul>
			{list.map((s) => (
				<li>
					{s.area ? <a href={areaUrl(s.area)}>{s.place}</a> : s.place}{s.tech && <span class="tech" data-pagefind-ignore="all"> ({s.tech})</span>}
					{s.qty && s.qty > 1 ? ` ×${s.qty}` : ''}
					{s.near ? ` (${s.near})` : ''}
					{s.note && <> — {s.note}</>}
					{s.pay ? (kind === 'bought/exchanged' ? ` (costs ${s.pay})` : ` (${s.pay})`) : ''}
					{kind === 'shop' && s.price ? ` · ${money(s.price)}` : ''}
					{(s.quests ?? []).map((q, n) => <>{n === 0 ? ' · see ' : ', '}<a href={url(q.href)}>{q.title}</a></>)}
				</li>
			))}
		</ul>
	</>)}
	{wildHeld.length > 0 && <>
		<h2 id="wild-held">Wild Pokémon holding this item</h2>
		<p>These wild Pokémon can carry {i.name}. The hold chance is the base chance that the Pokémon has the item when encountered, before Ability effects such as Compound Eyes. The encounter chance shows how often that Pokémon appears for the listed method and time.</p>
		<p class="small muted">Locations are in rough story order for each Pokémon. Radio, swarm and other special encounters require the conditions shown; see the location page for details. <a href={url('/calendar/')}>Calendar encounters</a> can replace ordinary encounter slots. Safari Zone entries depend on the selected area and, where noted, its objects and their development. A dash means no fixed encounter chance is listed.</p>
		<table class="compact">
			<thead><tr><th>Pokémon</th><th>Hold chance</th><th>Locations</th></tr></thead>
			<tbody>{wildHeld.map((holder) => <tr>
				<td><a href={pokemonUrl(holder.species)}>{speciesById.get(holder.species)?.name ?? `Pokémon ${holder.species}`}</a></td>
				<td>{holder.chance}%</td>
				<td><a href={`#wild-holder-${holder.species}`}>View locations ({new Set(holder.locations.map((location) => location.area)).size})</a></td>
			</tr>)}</tbody>
		</table>
		{wildHeld.map((holder) => <>
			<h3 id={`wild-holder-${holder.species}`}><a href={pokemonUrl(holder.species)}>{speciesById.get(holder.species)?.name ?? `Pokémon ${holder.species}`}</a> · {holder.chance}% hold chance</h3>
			<table class="compact">
				<thead><tr><th>Location</th><th>Method / time / condition</th><th>Level</th><th>Encounter chance</th></tr></thead>
				<tbody>{holder.locations.map((location) => <tr>
					<td><a href={areaUrl(location.area)}>{areaBySlug.get(location.area)?.name ?? location.place}</a>{location.place !== areaBySlug.get(location.area)?.name && <span class="small muted"> · {location.place}</span>}</td>
					<td>{location.method}</td><td>{location.level}</td><td>{location.encounterRate == null ? '—' : `${location.encounterRate}%`}</td>
				</tr>)}</tbody>
			</table>
		</>)}
	</>}
	{forms.length > 0 && <>
		<h2>Held-item transformation</h2>
		<FormChanges entries={forms} />
	</>}
	{i.neededBy.length > 0 && <>
		<h2>Used or asked for in</h2>
		<p>Someone in these places asks for this item or takes it: {i.neededBy.map((n, k) => <>{k > 0 && ', '}{n.area ? <a href={areaUrl(n.area)}>{n.place}</a> : n.place}</>)}.</p>
	</>}
	<p><a href={url('/items/')}>← All items</a></p>
</StarlightPage>
