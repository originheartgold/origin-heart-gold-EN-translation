---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';


import TutorDetails from '../../components/TutorDetails.astro';
import CalendarEncounters from '../../components/CalendarEncounters.astro';
import EncTable from '../../components/EncTable.astro';
import EncounterHints from '../../components/EncounterHints.astro';
import TrainerCard from '../../components/TrainerCard.astro';
import Mon from '../../components/Mon.astro';
import { areas, trainerById, itemById, itemUrl, tutors, moveById, moveUrl, regionLabel, url, type Area, type Quest } from '../../lib/data';
import meta from '../../data/meta.json';
import { getCollection } from 'astro:content';
import { slug as ghSlug } from 'github-slugger';

export function getStaticPaths() {
	return areas.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Area };

// Quests whose heading starts with this place: read from the generated guide pages.
const guide = await getCollection('docs', (e) => e.id.startsWith('guide/'));
const quests: { title: string; href: string }[] = [];
const re = new RegExp(`<a class="tag tag-place" href="[^"]*/locations/${a.slug}/">`);
for (const e of guide) {
	const body = e.body ?? '';
	const parts = body.split(/\n(?=## )/);
	for (const p of parts) {
		if (!p.startsWith('## ') || !re.test(p)) continue;
		const title = p.slice(3, p.indexOf('\n') > 0 ? p.indexOf('\n') : undefined).trim();
		const slug = ghSlug(title);
		quests.push({ title, href: url(`/${e.id}/#${slug}`) });
	}
}
const localTutors = tutors.filter(t => t.places.some(p => p.area === a.slug));
const trainers = a.trainers.map((id) => trainerById.get(id)).filter((t) => t !== undefined);
const headings = [
	quests.length && { depth: 2, slug: 'quests', text: 'Quests and events' },
	(a.encounters.length || a.headbutt.length || a.safari.length || a.encNotes.length || a.contest) && { depth: 2, slug: 'wild', text: 'Wild Pokémon' },
	a.calendar.length && { depth: 2, slug: 'calendar', text: 'Calendar encounters' },
	(a.statics.length || a.trades.length) && { depth: 2, slug: 'special', text: 'Gifts, trades and scripted encounters' },
	trainers.length && { depth: 2, slug: 'trainers', text: 'Trainers' },
	(a.items.length || a.gifts.length) && { depth: 2, slug: 'items', text: 'Items' },
	localTutors.length && { depth: 2, slug: 'tutors', text: 'Move tutors' },
	a.shops.length && { depth: 2, slug: 'shops', text: 'Shops' },
].filter(Boolean) as { depth: number; slug: string; text: string }[];
const gifts = a.gifts.filter((g) => g.kind === 'gift');
const prizes = a.gifts.filter((g) => g.kind === 'prize');
const paid = a.gifts.filter((g) => g.kind === 'bought/exchanged');
const rateNames = (meta as { rateNames: Record<string, string> }).rateNames;
const rates = (r: Record<string, number>) => Object.entries(r).map(([k, v]) => `${rateNames[k] ?? k} ${v}`).join(' · ');
const questLinks = (qs: Quest[] | undefined) => (qs ?? []).map((q) => ({ title: q.title, href: url(q.href) }));
const iu = (id: number) => itemUrl(itemById.get(id));
---
<StarlightPage frontmatter={{ title: a.name, description: `${a.name} in Origin HeartGold: quests, wild Pokémon, trainers, items and shops.` }} headings={headings}>
	<p class="small muted">{regionLabel(a.region)}</p>

	{quests.length > 0 && <>
		<h2 id="quests">Quests and events</h2>
		<ul>{quests.map((q) => <li><a href={q.href}>{q.title}</a></li>)}</ul>
	</>}

	{(a.encounters.length > 0 || a.headbutt.length > 0 || a.safari.length > 0 || a.encNotes.length > 0 || a.contest) && <>
		<h2 id="wild">Wild Pokémon</h2>
		<details class="enc-help"><summary>How to read these tables</summary><p class="small">{(meta as { encExplainer: string }).encExplainer}</p><p>These are the ordinary encounter tables. <a href={url('/calendar/')}>Calendar encounters</a> can replace specific land slots. <a href={url('/mechanics/#visible-encounters-and-shinies')}>Visible spawns and capture-chain bonuses</a> use additional rules; table weights are not shiny odds.</p></details>
		{a.encNotes.map((n) => <p class="small">{n}</p>)}
		{a.encounters.map((e) => <>
			<h3>{e.label}</h3>
			<p class="small muted">Encounter rate: {rates(e.rates)}</p>
			<EncTable sections={e.sections} />
		</>)}
		{a.safari.length > 0 && <>
			<h3><EncounterHints text="Safari Zone" /> areas</h3>
			<p>These are the candidate Pokémon for each selected area, method and time. Additional species require placed objects and their development. A dash means the scan does not establish a fixed encounter percentage.</p>
			{a.safari.map((section) => <details><summary>{section.title}</summary><EncTable sections={[section]} /></details>)}
		</>}
		{a.contest && <>
			<h3><EncounterHints text="Bug-Catching Contest" /></h3>
			<p class="small">{a.contest.note} Rate is the slot weight; score is the base points for the catch.</p>
			<div class="enc-grid">
				{a.contest.sets.map((st) => (
					<div class="enc-block">
						<h4>{st.title}</h4>
						<table class="compact">
							<thead><tr><th>Pokémon</th><th>Level</th><th>Rate</th><th>Score</th></tr></thead>
							<tbody>{st.rows.map((r) => <tr><td><Mon id={r.id} name={r.name} /></td><td>{r.level}</td><td>{r.rate}</td><td>{r.score}</td></tr>)}</tbody>
						</table>
					</div>
				))}
			</div>
		</>}
		{a.headbutt.map((h) => <>
			<h3><EncounterHints text="Headbutt" /> trees: {h.label}</h3>
			<p class="small">{h.trees} normal trees{h.special ? `, ${h.special} special trees` : ''}. Whether a tree is "common" or "rare" depends on your Trainer ID.</p>
			<EncTable sections={h.sections} />
		</>)}
	</>}


	{localTutors.length > 0 && <><h2 id="tutors">Move tutors</h2>{localTutors.map(t => <><h3><a href={moveUrl(moveById.get(t.move))}>{t.moveName}</a></h3><TutorDetails entries={[t]} /></>)}<p><a href={url('/tutors/')}>All tutors and eligibility lists →</a></p></>}
	{a.calendar.length > 0 && <>
		<h2 id="calendar">Calendar encounters</h2>
		<p>These Pokémon appear on specific dates, only in the named part of this location. <a href={url('/calendar/')}>Full calendar and caveats</a>.</p>
		<CalendarEncounters entries={a.calendar} />
	</>}

	{(a.statics.length > 0 || a.trades.length > 0) && <>
		<h2 id="special">Gifts, trades and scripted encounters</h2>
		<ul>
			{a.statics.map((s) => <li>{({ gift: 'Gift', egg: 'Gift Egg', static: 'Scripted wild battle' } as Record<string, string>)[s.kind] ?? s.kind}: <Mon id={s.id} name={s.name} />{s.level ? ` (Lv. ${s.level})` : ''} — {s.place}{s.conditions.length > 0 && <p>{s.conditions.join(' ')}</p>}{questLinks(s.quests).map((q, i) => <>{i === 0 ? 'See ' : ', '}<a href={q.href}>{q.title}</a></>)}</li>)}
			{a.trades.map((t) => <li>{t.label || (t.loan ? 'Temporary loan' : 'Trade')}: {!t.loan && <><Mon id={t.give} name={t.giveName} /> for </>}<Mon id={t.get} name={t.getName} />{t.level ? ` (Lv. ${t.level})` : ''}{t.nickname ? ` ("${t.nickname}")` : ''}{t.conditions.length > 0 && <p>{t.conditions.join(' ')}</p>}</li>)}
		</ul>
		<p class="small muted">Some of these depend on your starter, story progress or a choice.{quests.length > 0 && ' See the quests above.'}</p>
	</>}

	{trainers.length > 0 && <>
		<h2 id="trainers">Trainers</h2>
		<p class="small">Click a trainer to see their team. Some battles only happen in certain story branches; check the conditions below.</p>
		{trainers.map((t) => <TrainerCard t={t} area={a.slug} />)}
	</>}

	{(a.items.length > 0 || a.gifts.length > 0) && <>
		<h2 id="items">Items</h2>
		{a.items.length > 0 && (
			<table class="compact">
				<thead><tr><th>Item</th><th>Qty</th><th>Kind</th><th>Where</th></tr></thead>
				<tbody>{a.items.map((i) => <tr><td><a href={iu(i.id)}>{i.name}</a></td><td>{i.qty}</td><td>{i.kind}</td><td>{i.map}{i.near ? <span class="small muted"> · {i.near}</span> : ''}</td></tr>)}</tbody>
			</table>
		)}
		{gifts.length > 0 && <>
			<h3>Gifts from people</h3>
			<ul>{gifts.map((g) => <li><a href={iu(g.id)}>{g.name}</a>{g.qty > 1 ? ` ×${g.qty}` : ''}{questLinks(g.quests).map((q, i) => <>{i === 0 ? ' · see ' : ', '}<a href={q.href}>{q.title}</a></>)}</li>)}</ul>
			<p class="small muted">Some gifts depend on a quest, a choice or the day of the week; a linked quest explains when.</p>
		</>}
		{prizes.length > 0 && <>
			<h3>Prizes and menu choices</h3>
			<p class="small muted">You get one of these at a time: from a prize draw, a menu, a vending machine or an exchange counter.</p>
			<table class="compact">
				<thead><tr><th>Item</th><th>Qty</th><th>How</th></tr></thead>
				<tbody>{prizes.map((g) => <tr><td><a href={iu(g.id)}>{g.name}</a></td><td>{g.qty}</td><td>{g.pay}</td></tr>)}</tbody>
			</table>
		</>}
		{paid.length > 0 && <>
			<h3>Bought or exchanged</h3>
			<table class="compact">
				<thead><tr><th>Item</th><th>Qty</th><th>Price</th></tr></thead>
				<tbody>{paid.map((g) => <tr><td><a href={iu(g.id)}>{g.name}</a></td><td>{g.qty}</td><td>{g.pay}</td></tr>)}</tbody>
			</table>
		</>}
	</>}

	{a.shops.length > 0 && <>
		<h2 id="shops">Shops</h2>
		{a.shops.map((s) => (
			<details class="shop">
				<summary>{s.room || 'Shop counter'} ({s.stock.length} items)</summary>
				<table class="compact">
					<thead><tr><th>Item</th><th>Price</th></tr></thead>
					<tbody>{s.stock.map((i) => <tr><td><a href={iu(i.id)}>{i.name}</a></td><td>${i.price.toLocaleString('en-US')}</td></tr>)}</tbody>
				</table>
			</details>
		))}
	</>}

</StarlightPage>
