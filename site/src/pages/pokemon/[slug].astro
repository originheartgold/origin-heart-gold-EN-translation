---
import { playerNote } from '../../lib/reference-format.mjs';

import CatchDifficulty from '../../components/CatchDifficulty.astro';
import WildEncounters from '../../components/WildEncounters.astro';
import PokemonAcquisitions from '../../components/PokemonAcquisitions.astro';
import Availability from '../../components/Availability.astro';
import FormChanges from '../../components/FormChanges.astro';
import CalendarEncounters from '../../components/CalendarEncounters.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Type from '../../components/Type.astro';
import PokemonImage from '../../components/PokemonImage.astro';
import AbilityLink from '../../components/AbilityLink.astro';
import MoveTable from '../../components/MoveTable.astro';
import Evolution from '../../components/Evolution.astro';
import { species, speciesById, tmByLabel, tms, itemById, itemUrl, tutorsByMove, url, STAT_NAMES, type Species } from '../../lib/data';

export function getStaticPaths() {
	return species.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Species };
const acquisition = s.otherSources;
const obtainableForm = s.formChanges.some(f => f.result === s.id && speciesById.get(f.base)?.how);
const total = s.stats.reduce((a, b) => a + b, 0);
const ev = s.ev.map((v, i) => (v ? `${v} ${STAT_NAMES[i]}` : '')).filter(Boolean).join(', ') || '—';
const idx = species.findIndex((x) => x.id === s.id);
const prev = species[idx - 1], next = species[idx + 1];
const tmRows = s.tms === 'all' ? tms.map(t => ({ id: t.moveId, label: t.label, href: itemUrl(itemById.get(t.itemId)) })) : s.tms.map(([label, id]) => ({ id, label, href: itemUrl(itemById.get(tmByLabel.get(label)?.itemId ?? -1)) }));
const headings = [
	{ depth: 2, slug: 'where', text: 'Where to find it' },
	...(s.formChanges.length ? [{ depth: 2, slug: 'forms', text: 'Held-item forms' }] : []),
	...(s.calendar.length ? [{ depth: 2, slug: 'calendar', text: 'Calendar encounters' }] : []),
	{ depth: 2, slug: 'evolution', text: 'Evolution' },
	{ depth: 2, slug: 'moves', text: 'Level-up moves' },
	{ depth: 2, slug: 'tm', text: 'TMs and HMs' },
	...(s.tutors.length ? [{ depth: 2, slug: 'tutors', text: 'Move tutors' }] : []),
	...(s.egg.length ? [{ depth: 2, slug: 'egg', text: 'Egg moves' }] : []),
];
---
<StarlightPage
	frontmatter={{ title: `#${String(s.baseSpeciesId).padStart(4, '0')} ${s.name}`, description: `${s.name} in Origin HeartGold: types, abilities, base stats, moves and where to catch it.` }}
	headings={headings}
>
	<Availability reason={s.unavailableReason} detail />
	<div class="pokemon-overview"><PokemonImage s={s} size="large" /><div class="mon-head">
		<div class="types">{s.types.map((t) => <Type type={t} />)}{s.game && <span class="small muted"> In-game spelling: {s.game}</span>}</div>
		<dl class="facts">
			<dt>Abilities</dt><dd>{s.abilityIds.length ? s.abilityIds.map(id => <AbilityLink id={id} summary />) : '—'}</dd>
			<dt>Hidden ability</dt><dd><AbilityLink id={s.hiddenAbilityId} summary /></dd>
			<dt>Capture</dt><dd><CatchDifficulty value={s.catch} /></dd>
			<dt>Gender</dt><dd>{s.gender}</dd>
			<dt>Egg groups</dt><dd>{s.eggGroups.join(' / ')}</dd>
			<dt>Growth</dt><dd>{s.growth}</dd>
			<dt>EV yield</dt><dd>{ev}</dd>
			{s.held.length > 0 && <><dt>Wild held item</dt><dd>{s.held.join(', ')}</dd></>}
		</dl>
	</div></div>

	<table class="stats compact">
		<tbody>
			{s.stats.map((v, i) => (
				<tr><th>{STAT_NAMES[i]}</th><td>{v}</td><td class="bar-cell"><span class="bar" style={`width:${Math.min(100, v / 2)}%`}></span></td></tr>
			))}
			<tr><th>Total</th><td>{total}</td><td></td></tr>
		</tbody>
	</table>

	<h2 id="where">Where to find it</h2>
	{s.acquisitions.length > 0 && <PokemonAcquisitions sources={s.acquisitions} />}
	{s.wildEncounters.length > 0 && <WildEncounters name={s.name} encounters={s.wildEncounters} />}
	{s.wildNotes.map(note => <p class="small">{playerNote(note)}</p>)}
	{s.unavailableReason ? <p>{playerNote(s.unavailableReason)}</p> : acquisition ? <p>{playerNote(acquisition)}</p> : s.wildEncounters.length || s.acquisitions.length ? null : obtainableForm ? <p>Available through a held-item transformation; see below.</p> : s.calendar.length ? <p>Appears on the date listed below.</p> : s.battleOnly ? null : <p><strong>No confirmed way to get it.</strong> {playerNote(s.note) || 'No location or evolution route is known.'}</p>}
	{s.battleOnly && <p><strong>{s.how ? 'Also in battle.' : 'Seen only in battle.'}</strong> {s.battleOnly}{s.how ? '' : " It can't be kept in this form."}</p>}
	{s.formChanges.length > 0 && <>
		<h2 id="forms">Held-item forms</h2>
		<FormChanges entries={s.formChanges} />
	</>}
	{s.calendar.length > 0 && <>
		<h2 id="calendar">Calendar encounters</h2>
		<p>These Pokémon appear on specific dates. Check each entry’s availability and any special conditions. <a href={url('/calendar/')}>Calendar rules and caveats</a>.</p>
		<CalendarEncounters entries={s.calendar} />
	</>}
	{(s.quests ?? []).length > 0 && <p>See the quest guide: {(s.quests ?? []).map((q, i) => <>{i > 0 && '; '}<a href={url(q.href)}>{q.title}</a></>)}.</p>}

	<h2 id="evolution">Evolution</h2>
	{s.evoFrom.length === 0 && s.evoTo.length === 0 && <p>Does not evolve.</p>}
	{s.evoFrom.length > 0 && <Evolution label="Evolves from" entries={s.evoFrom} />}
	{s.evoTo.length > 0 && <Evolution label="Evolves into" entries={s.evoTo} />}
	{s.evoNotes.map((n) => <p>{playerNote(n)}</p>)}

	<h2 id="moves">Level-up moves</h2>
  <p class="small">“On evolution” moves are learned when this Pokémon evolves. Open a move for its full effects and any special behavior in this hack.</p>
  <MoveTable rows={s.levelup.map(([lv,id]) => ({ id, label: lv === 0 ? 'On evolution' : String(lv) }))} label="Level" />
  <h2 id="tm">TMs and HMs</h2>
  {s.tms === 'all' && <p>Can learn every TM and HM. All {tms.length} TMs and HMs are listed below.</p>}
  {tmRows.length ? <MoveTable rows={tmRows} label="TM / HM" /> : <p>None.{s.tmNote ? ` ${s.tmNote}` : ''}</p>}
  {s.tutors.length > 0 && <><h2 id="tutors">Move tutors</h2><MoveTable rows={s.tutors.map(id => ({ id, tutors: tutorsByMove.get(id) ?? [] }))} tutorMode /></>}
  {s.egg.length > 0 && <><h2 id="egg">Egg moves</h2><MoveTable rows={s.egg.map(id => ({id}))} /></>}

	<nav class="prevnext">
		{prev ? <a href={url(`/pokemon/${prev.slug}/`)}>← #{prev.baseSpeciesId} {prev.name}</a> : <span></span>}
		<a href={url('/pokemon/')}>All Pokémon</a>
		{next ? <a href={url(`/pokemon/${next.slug}/`)}>#{next.baseSpeciesId} {next.name} →</a> : <span></span>}
	</nav>
</StarlightPage>
