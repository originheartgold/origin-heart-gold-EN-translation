---
import Availability from '../../components/Availability.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Type from '../../components/Type.astro';
import { species, url, hasDocumentedSource } from '../../lib/data';
const regions = [...new Set(species.map((s) => s.region))];
---
<StarlightPage frontmatter={{ title: 'Pokémon', description: 'Every Pokémon in Origin HeartGold: types, abilities, base stats and how to get it.', tableOfContents: false }}>
	<p>All {species.length} species and forms in the game data, including entries unavailable through normal play. Availability labels distinguish confirmed sources, battle-only forms and entries whose source is unknown. NOT AVAILABLE IN GAME means unavailable through normal play; the data remains here for save-editor and in-game generator reference.</p>
	<p><a href={url('/calendar/')}>Browse calendar encounters</a> · <a href={url('/mechanics/#held-item-forms')}>Held-item transformations</a></p>
	<div class="table-filter" data-table="mon-table">
		<input type="search" placeholder="Search by name, type or ability…" aria-label="Search Pokémon" />
		<select data-key="region" aria-label="Region">
			<option value="">All Pokédex ranges</option>
			{regions.map((r) => <option value={r}>{r}</option>)}
		</select>
		<select data-key="availability" aria-label="Availability">
			<option value="">All availability</option>
			<option value="documented">Documented source</option>
			<option value="battle">Battle only</option>
			<option value="unavailable">NOT AVAILABLE IN GAME</option>
			<option value="unknown">No confirmed source</option>
		</select>
		<span class="filter-count" aria-live="polite"></span>
	</div>
	<table id="mon-table" class="sortable compact">
		<thead><tr><th>#</th><th>Pokémon</th><th>Type</th><th>Abilities</th><th>Hidden</th><th>BST</th><th>Availability</th></tr></thead>
		<tbody>
			{species.map((s) => (
				<tr data-region={s.region} data-availability={s.unavailableReason ? 'unavailable' : hasDocumentedSource(s) ? 'documented' : s.battleOnly ? 'battle' : 'unknown'}>
					<td>{s.id}</td>
					<td><a href={url(`/pokemon/${s.slug}/`)}>{s.name}</a>{s.game && <span class="sr-only"> {s.game}</span>}</td>
					<td>{s.types.map((t) => <Type type={t} />)}</td>
					<td>{s.abilities.join(' / ')}</td>
					<td>{s.hidden ?? '—'}</td>
					<td>{s.stats.reduce((a, b) => a + b, 0)}</td>
					<td>{s.unavailableReason ? <Availability reason={s.unavailableReason} /> : hasDocumentedSource(s) ? 'Documented source' : s.battleOnly ? 'Battle only' : 'No confirmed source'}</td>
				</tr>
			))}
		</tbody>
	</table>
</StarlightPage>
