---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Type from '../../components/Type.astro';
import { moves, species, itemByName, itemUrl, url } from '../../lib/data';
// Who learns each move (level-up, TM, tutor, egg) — computed at build time.
const learners = new Map<number, Set<number>>();
const add = (m: number, s: number) => { if (!learners.has(m)) learners.set(m, new Set()); learners.get(m)!.add(s); };
for (const s of species) {
	if (!s.how) continue;
	s.levelup.forEach(([, m]) => add(m, s.id));
	if (s.tms === 'all') moves.filter((m) => m.tm.length).forEach((m) => add(m.id, s.id)); // Mew: every TM and HM
	else s.tms.forEach(([, m]) => add(m, s.id));
	s.tutors.forEach((m) => add(m, s.id));
	s.egg.forEach((m) => add(m, s.id));
}
const tms = moves.filter((m) => m.tm.length).sort((a, b) => a.tm[0].localeCompare(b.tm[0], 'en', { numeric: true }));
// "TM26" -> the TM's own item page (where to find it)
const tmLink = (label: string, name: string) => itemUrl(itemByName.get(`${label} ${name}`));
const tmUnavailable = (label: string, name: string) => !!itemByName.get(`${label} ${name}`)?.unavailableReason;
---
<StarlightPage frontmatter={{ title: 'Moves and TMs', description: 'All moves in Origin HeartGold with type, category, power, accuracy, PP and TM numbers.' }}
	headings={[{ depth: 2, slug: 'all-moves', text: 'All moves' }, { depth: 2, slug: 'tm-list', text: 'TM and HM list' }]}>
	<p>Move data as the game reads it. "var." power is calculated in battle; "—" accuracy never misses.
	"Learned by" counts the Pokémon with a source we found in the game data that can learn the move in any way
	(level-up, TM or HM, tutor or Egg move). TM numbers link to where you find the TM; TM46 (Thief) can't be obtained in this game.</p>
	<h2 id="all-moves">All moves</h2>
	<div class="table-filter" data-table="move-table">
		<input type="search" placeholder="Search moves or types…" aria-label="Search moves" />
		<span class="filter-count" aria-live="polite"></span>
	</div>
	<table id="move-table" class="sortable compact">
		<thead><tr><th>Move</th><th>Type</th><th>Cat.</th><th>Power</th><th>Acc.</th><th>PP</th><th>TM</th><th>Learned by</th></tr></thead>
		<tbody>
			{moves.map((m) => (
				<tr id={`move-${m.id}`}>
					<td>{m.name}{m.game && <span class="sr-only"> {m.game}</span>}</td><td><Type type={m.type} /></td><td>{m.cat}</td><td>{m.power}</td><td>{m.acc}</td><td>{m.pp}</td>
					<td>{m.tm.map((t, i) => <>{i > 0 && ', '}{tmLink(t, m.name) ? <><a href={tmLink(t, m.name)}>{t}</a>{tmUnavailable(t, m.name) && <span class="small muted"> (NOT AVAILABLE IN GAME)</span>}</> : <>{t} <span class="small muted">(can't be obtained)</span></>}</>)}</td><td>{learners.get(m.id)?.size ?? 0}</td>
				</tr>
			))}
		</tbody>
	</table>
	<h2 id="tm-list">TM and HM list</h2>
	<table class="compact">
		<thead><tr><th>TM</th><th>Move</th><th>Type</th><th>Cat.</th><th>Power</th><th>Acc.</th><th>PP</th></tr></thead>
		<tbody>
			{tms.flatMap((m) => m.tm.map((t) => (
				<tr><td>{tmLink(t, m.name) ? <><a href={tmLink(t, m.name)}>{t}</a>{tmUnavailable(t, m.name) && <span class="small muted"> (NOT AVAILABLE IN GAME)</span>}</> : <>{t} <span class="small muted">(can't be obtained)</span></>}</td><td><a href={`#move-${m.id}`}>{m.name}</a></td><td><Type type={m.type} /></td><td>{m.cat}</td><td>{m.power}</td><td>{m.acc}</td><td>{m.pp}</td></tr>
			)))}
		</tbody>
	</table>
	<p class="small muted">Click a TM number to see where to find it, or browse all <a href={url('/items/')}>Items</a>.</p>
</StarlightPage>
